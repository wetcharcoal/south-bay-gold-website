# Copy to `.env.local` (gitignored). Vite loads these before `vite.config.ts` runs.
#
# After `dfx deploy`, set II_URL to your local Internet Identity canister, e.g.:
# II_URL=http://localhost:4943/?canisterId=<YOUR_II_CANISTER_ID>

II_URL=

# Optional fallback if you are not using public/env.json:
# CANISTER_ID_BACKEND=

# Optional; when set, overrides storage gateway when loading env.json path in config.ts
# STORAGE_GATEWAY_URL=
